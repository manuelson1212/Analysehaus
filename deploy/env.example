# Copy to .env on the server (never commit .env). Lines starting with # are ignored.
DOMAIN=apexwave.pro

# Long random values. Create them on the server with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_PASSWORD=

# AI agent: keep "mock" until your key is in, then switch to "claude".
AGENT_PROVIDER=mock
ANTHROPIC_API_KEY=

# Payments: leave empty until Stripe is set up (see DEPLOY.md).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=0

# Email for "forgot password" (mailbox info@apexwave.pro at Hostinger). Leave SMTP_PASS empty until set up.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@apexwave.pro
SMTP_PASS=
MAIL_FROM='Apex Wave Capital <info@apexwave.pro>'

# Daily 09:00 briefing draft (0 = off).
BRIEFING_AUTO=0
BRIEFING_NEWS=none
